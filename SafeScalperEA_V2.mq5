//+------------------------------------------------------------------+\n//|                        SafeScalperEA V2.0                         |\n//|    Advanced Scalper: Multi-TF Trend + RSI Divergence + Smart MM   |\n//|    Features: Position caching, better SL/TP logic, reduced ticks  |\n//+------------------------------------------------------------------+\n#property strict\n#property version "2.00"\n\n//============================= INPUTS ===============================\ninput group "=== Symbol / Timeframe ==="\ninput ENUM_TIMEFRAMES InpSignalTF    = PERIOD_M15;  // Primary timeframe\ninput ENUM_TIMEFRAMES InpConfirmTF   = PERIOD_H1;   // Confirmation timeframe\ninput bool   InpUseMultiTF           = true;        // Enable multi-TF filter\n\ninput group "=== Strategy (Advanced Scalper) ==="\ninput int    InpFastEMA              = 9;           // Fast EMA\ninput int    InpSlowEMA              = 21;          // Slow EMA\ninput int    InpRSIPeriod            = 14;          // RSI Period\ninput double InpRSI_BuyLevel         = 55.0;        // Buy signal level\ninput double InpRSI_SellLevel        = 45.0;        // Sell signal level\ninput bool   InpUseDivergence        = true;        // Detect RSI divergence\ninput bool   InpUseVolume            = true;        // Volume confirmation\n\ninput group "=== Risk & Money Management ==="\ninput double InpRiskPercent          = 1.0;         // Risk per trade (%)\ninput double InpMaxDailyLossPct      = 5.0;         // Daily loss limit (%)\ninput double InpMaxWeeklyLossPct     = 10.0;        // Weekly loss limit (%)\ninput int    InpMaxTradesPerDay      = 8;           // Max trades/day\ninput int    InpMaxConsecLosses      = 3;           // Stop after N losses\ninput int    InpCooldownMinutes      = 5;           // Min between entries (reduced)\ninput bool   InpScaleIn              = true;        // Add-on after profit\ninput double InpScaleInProfit        = 0.5;         // Scale in after 0.5 ATR profit\n\ninput group "=== Stops / Targets ==="\ninput int    InpATRPeriod            = 14;          // ATR period\ninput double InpSL_ATR_Mult          = 1.0;         // SL = ATR * mult (tighter)\ninput double InpTP_ATR_Mult          = 1.5;         // TP = ATR * mult (better RR)\ninput bool   InpUseBreakEven          = true;       // Move SL to BE\ninput double InpBE_ATR_Mult          = 0.6;         // BE trigger distance\ninput bool   InpUseTrailing           = true;       // Smart trailing stop\ninput double InpTrail_ATR_Mult       = 0.5;         // Trailing distance\n\ninput group "=== Execution Filters ==="\ninput int    InpMaxSpreadPoints      = 50;          // Max spread (points)\ninput int    InpMinVolumeMA          = 20;          // Volume MA period\ninput int    InpSlippagePoints       = 20;          // Deviation\ninput int    InpMagic                = 20260215;    // Magic number\n\n//============================= GLOBALS ==============================\n// Handles\nint hFast = INVALID_HANDLE, hSlow = INVALID_HANDLE, hRsi = INVALID_HANDLE;\nint hAtr = INVALID_HANDLE, hVolume = INVALID_HANDLE;\nint hConfirmFast = INVALID_HANDLE, hConfirmSlow = INVALID_HANDLE;\n\n// Time tracking\ndatetime g_lastBarTime = 0, g_lastConfirmBarTime = 0;\ndatetime g_lastEntryTime = 0;\ndatetime g_weekStart = 0;\n\n// Daily/Weekly stats\ndouble   g_dayStartBalance = 0.0, g_weekStartBalance = 0.0;\nint      g_dayOfYear = -1, g_weekOfYear = -1;\nint      g_tradesToday = 0, g_tradesThisWeek = 0;\nint      g_consecLosses = 0;\ndouble   g_lastTradeResult = 0.0;\n\n// Position cache\nstruct PosCache\n{\n   bool exists;\n   ulong ticket;\n   long type;\n   double openPrice;\n   double sl;\n   double tp;\n   double volume;\n   datetime openTime;\n} g_posCache;\n\n// Indicator cache\nstruct IndicatorCache\n{\n   double fastEMA, slowEMA, rsi, atr;\n   double fastEMA_Confirm, slowEMA_Confirm;\n   double volume, volumeMA;\n   double rsiPrev, rsiPrev2;\n   bool valid;\n} g_cache;\n\n//============================= UTILITY FUNCTIONS ====================\n\nbool IsNewDay()\n{\n   MqlDateTime t; TimeToStruct(TimeCurrent(), t);\n   int doy = t.day_of_year;\n   if(doy != g_dayOfYear)\n   {\n      g_dayOfYear = doy;\n      g_tradesToday = 0;\n      g_dayStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);\n      g_consecLosses = 0;\n      return true;\n   }\n   return false;\n}\n\nbool IsNewWeek()\n{\n   MqlDateTime t; TimeToStruct(TimeCurrent(), t);\n   int wow = t.week_of_year;\n   if(wow != g_weekOfYear)\n   {\n      g_weekOfYear = wow;\n      g_tradesThisWeek = 0;\n      g_weekStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);\n      return true;\n   }\n   return false;\n}\ndouble GetDailyLossPct()\n{\n   if(g_dayStartBalance <= 0) return 0.0;\n   double bal = AccountInfoDouble(ACCOUNT_BALANCE);\n   double dd = (g_dayStartBalance - bal) / g_dayStartBalance * 100.0;\n   return MathMax(dd, 0.0);\n}\ndouble GetWeeklyLossPct()\n{\n   if(g_weekStartBalance <= 0) return 0.0;\n   double bal = AccountInfoDouble(ACCOUNT_BALANCE);\n   double dd = (g_weekStartBalance - bal) / g_weekStartBalance * 100.0;\n   return MathMax(dd, 0.0);\n}\nint SpreadPoints()\n{\n   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);\n   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);\n   if(ask <= 0 || bid <= 0) return 999999;\n   return (int)MathRound((ask - bid) / _Point);\n}\ndouble RoundToTick(double price)\n{\n   double ts = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);\n   if(ts <= 0) return price;\n   return MathRound(price / ts) * ts;\n}\ndouble GetBufferValue(int handle, int shift)\n{\n   double buf[];\n   ArraySetAsSeries(buf, true);\n   int copied = CopyBuffer(handle, 0, 0, shift + 2, buf);\n   if(copied < shift + 2) return EMPTY_VALUE;\n   return buf[shift];\n}\nvoid RefreshPositionCache()\n{\n   g_posCache.exists = false;\n   g_posCache.ticket = 0;\n\n   for(int i = 0; i < PositionsTotal(); i++)\n   {\n      ulong ticket = PositionGetTicket(i);\n      if(ticket == 0) continue;\n      if(!PositionSelectByTicket(ticket)) continue;\n\n      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&\n         (int)PositionGetInteger(POSITION_MAGIC) == InpMagic)\n      {\n         g_posCache.exists = true;\n         g_posCache.ticket = ticket;\n         g_posCache.type = PositionGetInteger(POSITION_TYPE);\n         g_posCache.openPrice = PositionGetDouble(POSITION_PRICE_OPEN);\n         g_posCache.sl = PositionGetDouble(POSITION_SL);\n         g_posCache.tp = PositionGetDouble(POSITION_TP);\n         g_posCache.volume = PositionGetDouble(POSITION_VOLUME);\n         g_posCache.openTime = (datetime)PositionGetInteger(POSITION_TIME);\n         return;\n      }\n   }\n}\nvoid RefreshIndicatorCache()\n{\n   g_cache.valid = false;\n\n   g_cache.fastEMA = GetBufferValue(hFast, 1);\n   g_cache.slowEMA = GetBufferValue(hSlow, 1);\n   g_cache.atr = GetBufferValue(hAtr, 1);\n   g_cache.rsi = GetBufferValue(hRsi, 1);\n   g_cache.rsiPrev = GetBufferValue(hRsi, 2);\n   g_cache.rsiPrev2 = GetBufferValue(hRsi, 3);\n\n   g_cache.volume = GetBufferValue(hVolume, 1);\n   g_cache.volumeMA = GetBufferValue(hVolume, InpMinVolumeMA);\n\n   if(InpUseMultiTF)\n   {\n      g_cache.fastEMA_Confirm = GetBufferValue(hConfirmFast, 1);\n      g_cache.slowEMA_Confirm = GetBufferValue(hConfirmSlow, 1);\n   }\n\n   if(g_cache.fastEMA != EMPTY_VALUE && g_cache.slowEMA != EMPTY_VALUE &&\n      g_cache.rsi != EMPTY_VALUE && g_cache.atr > 0)\n   {\n      g_cache.valid = true;\n   }\n}\ndouble NormalizeLots(double lots)\n{\n   double vmin = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);\n   double vmax = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);\n   double vstep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);\n\n   if(vmin <= 0) vmin = 0.01;\n   if(vstep <= 0) vstep = 0.01;\n\n   lots = MathMax(lots, vmin);\n   lots = MathMin(lots, vmax);\n\n   double steps = MathFloor(lots / vstep);\n   double out = steps * vstep;\n\n   return NormalizeDouble(out, 2);\n}\ndouble LotsFromRisk(double slDistancePrice)\n{\n   if(slDistancePrice <= 0) return 0.0;\n\n   double balance = AccountInfoDouble(ACCOUNT_BALANCE);\n   double riskMoney = balance * (InpRiskPercent / 100.0);\n\n   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);\n   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);\n\n   if(tickSize <= 0 || tickValue <= 0) return 0.0;\n\n   double valuePerPriceUnitPerLot = tickValue / tickSize;\n   double lots = riskMoney / (slDistancePrice * valuePerPriceUnitPerLot);\n\n   return NormalizeLots(lots);\n}\n//============================= SIGNAL DETECTION ====================\n\nbool HasBullDivergence()\n{\n   if(!InpUseDivergence) return false;\n   if(g_cache.rsi <= 30) return false;\n\n   double close = iClose(_Symbol, InpSignalTF, 1);\n   double closePrev = iClose(_Symbol, InpSignalTF, 2);\n\n   if(close < closePrev && g_cache.rsi > g_cache.rsiPrev)\n      return true;\n\n   return false;\n}\nbool HasBearDivergence()\n{\n   if(!InpUseDivergence) return false;\n   if(g_cache.rsi >= 70) return false;\n\n   double close = iClose(_Symbol, InpSignalTF, 1);\n   double closePrev = iClose(_Symbol, InpSignalTF, 2);\n\n   if(close > closePrev && g_cache.rsi < g_cache.rsiPrev)\n      return true;\n\n   return false;\n}\nbool IsVolumeConfirmed()\n{\n   if(!InpUseVolume) return true;\n   if(g_cache.volumeMA <= 0) return true;\n   return (g_cache.volume > g_cache.volumeMA * 0.9);\n}\nbool IsMultiTFConfirmed(bool bullish)\n{\n   if(!InpUseMultiTF) return true;\n   if(g_cache.fastEMA_Confirm == EMPTY_VALUE) return false;\n\n   if(bullish)\n      return (g_cache.fastEMA_Confirm > g_cache.slowEMA_Confirm);\n   else\n      return (g_cache.fastEMA_Confirm < g_cache.slowEMA_Confirm);\n}\n//============================= ORDER EXECUTION ====================\nbool SendOrder(ENUM_ORDER_TYPE type, double sl, double tp)\n{\n   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);\n   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);\n   double price = (type == ORDER_TYPE_BUY) ? ask : bid;\n\n   double slDist = MathAbs(price - sl);\n   double lots = LotsFromRisk(slDist);\n\n   if(lots <= 0)\n   {\n      Print("❌ LotsFromRisk failed. Check symbol settings.");\n      return false;\n   }\n\n   MqlTradeRequest req;\n   MqlTradeResult res;\n   ZeroMemory(req);\n   ZeroMemory(res);\n\n   req.action = TRADE_ACTION_DEAL;\n   req.symbol = _Symbol;\n   req.magic = InpMagic;\n   req.type = type;\n   req.volume = lots;\n   req.price = price;\n   req.sl = sl;\n   req.tp = tp;\n   req.deviation = InpSlippagePoints;\n   req.comment = "SafeScalper V2";\n\n   if(!OrderSend(req, res))\n   {\n      Print("❌ OrderSend error. Code: ", GetLastError());\n      return false;\n   }\n\n   if(res.retcode == 10008 || res.retcode == 10009)\n   {\n      Print("✅ ", (type == ORDER_TYPE_BUY ? "BUY" : "SELL"),\n            " | Lots: ", DoubleToString(lots, 2),\n            " | SL: ", DoubleToString(sl, _Digits),\n            " | TP: ", DoubleToString(tp, _Digits),\n            " | Risk: ", DoubleToString(InpRiskPercent, 1), "%");\n      return true;\n   }\n\n   Print("❌ Order rejected. Code: ", res.retcode);\n   return false;\n}\n//============================= POSITION MANAGEMENT ==================\nvoid ManageOpenPosition()\n{\n   if(!g_posCache.exists) return;\n\n   ulong ticket = g_posCache.ticket;\n   long type = g_posCache.type;\n   double openPrice = g_posCache.openPrice;\n   double sl = g_posCache.sl;\n   double tp = g_posCache.tp;\n\n   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);\n   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);\n   double cur = (type == POSITION_TYPE_BUY) ? bid : ask;\n\n   double profitMove = (type == POSITION_TYPE_BUY) ? (cur - openPrice) : (openPrice - cur);\n\n   if(InpUseBreakEven)\n   {\n      double beTrigger = g_cache.atr * InpBE_ATR_Mult;\n\n      if(profitMove >= beTrigger)\n      {\n         double newSL = openPrice;\n\n         if(type == POSITION_TYPE_BUY && sl < newSL)\n            ModifySLTP(ticket, RoundToTick(newSL), tp);\n         else if(type == POSITION_TYPE_SELL && (sl == 0 || sl > newSL))\n            ModifySLTP(ticket, RoundToTick(newSL), tp);\n      }\n   }\n\n   if(InpUseTrailing && profitMove > g_cache.atr * InpBE_ATR_Mult)\n   {\n      double trailDist = g_cache.atr * InpTrail_ATR_Mult;\n      double newSL = (type == POSITION_TYPE_BUY) ? (cur - trailDist) : (cur + trailDist);\n      newSL = RoundToTick(newSL);\n\n      if(type == POSITION_TYPE_BUY && newSL > sl)\n         ModifySLTP(ticket, newSL, tp);\n      else if(type == POSITION_TYPE_SELL && (sl == 0 || newSL < sl))\n         ModifySLTP(ticket, newSL, tp);\n   }\n\n   if(InpScaleIn && profitMove >= g_cache.atr * InpScaleInProfit)\n   {\n      if(g_posCache.volume <= LotsFromRisk(MathAbs(openPrice - sl)) * 1.1)\n      {\n         if(SendOrder(type, sl, tp))\n         {\n            Print("📈 Scaled in at profit: ", DoubleToString(profitMove, _Digits));\n         }\n      }\n   }\n}\nbool ModifySLTP(ulong ticket, double newSL, double newTP)\n{\n   MqlTradeRequest req;\n   MqlTradeResult res;\n   ZeroMemory(req);\n   ZeroMemory(res);\n\n   req.action = TRADE_ACTION_SLTP;\n   req.position = ticket;\n   req.symbol = _Symbol;\n   req.sl = newSL;\n   req.tp = newTP;\n\n   if(!OrderSend(req, res)) return false;\n\n   if(res.retcode == 10009 || res.retcode == 10008)\n   {\n      Print("🔧 Modified SL/TP. New SL: ", DoubleToString(newSL, _Digits));\n      return true;\n   }\n\n   return false;\n}\nvoid UpdateConsecLosses()\n{\n   for(int i = OrdersHistoryTotal() - 1; i >= MathMax(0, OrdersHistoryTotal() - 10); i--)\n   {\n      ulong ticket = OrderGetTicket(i);\n      if(ticket == 0) continue;\n\n      if(!HistoryOrderSelect(ticket)) continue;\n      if((int)OrderGetInteger(ORDER_MAGIC) != InpMagic) continue;\n\n      datetime closeTime = (datetime)OrderGetInteger(ORDER_TIME_DONE);\n      if(closeTime <= g_lastEntryTime) continue;\n\n      double profit = OrderGetDouble(ORDER_PROFIT);\n      if(profit < 0)\n      {\n         g_consecLosses++;\n         g_lastTradeResult = profit;\n      }\n      else\n      {\n         g_consecLosses = 0;\n         g_lastTradeResult = profit;\n      }\n\n      break;\n   }\n}\n//============================= INIT/DEINIT ==========================\nint OnInit()\n{\n   IsNewDay();\n   IsNewWeek();\n\n   hFast = iMA(_Symbol, InpSignalTF, InpFastEMA, 0, MODE_EMA, PRICE_CLOSE);\n   hSlow = iMA(_Symbol, InpSignalTF, InpSlowEMA, 0, MODE_EMA, PRICE_CLOSE);\n   hRsi = iRSI(_Symbol, InpSignalTF, InpRSIPeriod, PRICE_CLOSE);\n   hAtr = iATR(_Symbol, InpSignalTF, InpATRPeriod);\n   hVolume = iVolume(_Symbol, InpSignalTF);\n\n   if(InpUseMultiTF)\n   {\n      hConfirmFast = iMA(_Symbol, InpConfirmTF, InpFastEMA, 0, MODE_EMA, PRICE_CLOSE);\n      hConfirmSlow = iMA(_Symbol, InpConfirmTF, InpSlowEMA, 0, MODE_EMA, PRICE_CLOSE);\n\n      if(hConfirmFast == INVALID_HANDLE || hConfirmSlow == INVALID_HANDLE)\n      {\n         Print("ERROR: Confirm TF handles failed");\n         return INIT_FAILED;\n      }\n   }\n\n   if(hFast == INVALID_HANDLE || hSlow == INVALID_HANDLE ||\n      hRsi == INVALID_HANDLE || hAtr == INVALID_HANDLE || hVolume == INVALID_HANDLE)\n   {\n      Print("ERROR: Main indicator handles failed");\n      return INIT_FAILED;\n   }\n\n   Print("✅ SafeScalperEA V2 initialized on ", _Symbol,\n         " | Signal TF: ", EnumToString(InpSignalTF),\n         " | Confirm TF: ", EnumToString(InpConfirmTF));\n\n   return INIT_SUCCEEDED;\n}\nvoid OnDeinit(const int reason)\n{\n   if(hFast != INVALID_HANDLE) IndicatorRelease(hFast);\n   if(hSlow != INVALID_HANDLE) IndicatorRelease(hSlow);\n   if(hRsi != INVALID_HANDLE) IndicatorRelease(hRsi);\n   if(hAtr != INVALID_HANDLE) IndicatorRelease(hAtr);\n   if(hVolume != INVALID_HANDLE) IndicatorRelease(hVolume);\n\n   if(InpUseMultiTF)\n   {\n      if(hConfirmFast != INVALID_HANDLE) IndicatorRelease(hConfirmFast);\n      if(hConfirmSlow != INVALID_HANDLE) IndicatorRelease(hConfirmSlow);\n   }\n\n   Print("SafeScalperEA V2 stopped");\n}\n//============================= MAIN LOOP =============================\nbool IsNewBar()\n{\n   datetime t = iTime(_Symbol, InpSignalTF, 0);\n   if(t != g_lastBarTime)\n   {\n      g_lastBarTime = t;\n      return true;\n   }\n   return false;\n}\nvoid OnTick()\n{\n   IsNewDay();\n   IsNewWeek();\n\n   RefreshPositionCache();\n   RefreshIndicatorCache();\n\n   if(!g_cache.valid)\n      return;\n\n   if(g_posCache.exists)\n   {\n      ManageOpenPosition();\n      return;\n   }\n\n   UpdateConsecLosses();\n\n   if(GetDailyLossPct() >= InpMaxDailyLossPct)\n   {\n      Print("⚠️ Daily loss limit hit: ", DoubleToString(GetDailyLossPct(), 2), "%");\n      return;\n   }\n\n   if(GetWeeklyLossPct() >= InpMaxWeeklyLossPct)\n   {\n      Print("⚠️ Weekly loss limit hit: ", DoubleToString(GetWeeklyLossPct(), 2), "%");\n      return;\n   }\n\n   if(g_tradesToday >= InpMaxTradesPerDay)\n      return;\n\n   if(g_consecLosses >= InpMaxConsecLosses)\n   {\n      Print("⚠️ ", g_consecLosses, " consecutive losses. Pausing entries.");\n      return;\n   }\n\n   if(g_lastEntryTime > 0 && (TimeCurrent() - g_lastEntryTime) < (InpCooldownMinutes * 60))\n      return;\n\n   if(SpreadPoints() > InpMaxSpreadPoints)\n      return;\n\n   if(!IsNewBar())\n      return;\n\n   bool upTrend = (g_cache.fastEMA > g_cache.slowEMA);\n   bool downTrend = (g_cache.fastEMA < g_cache.slowEMA);\n\n   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);\n   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);\n\n   if(upTrend && g_cache.rsi > InpRSI_BuyLevel && IsVolumeConfirmed() &&\n      IsMultiTFConfirmed(true))\n   {\n      if(InpUseDivergence && !HasBullDivergence())\n         goto check_sell;\n\n      double sl = RoundToTick(bid - g_cache.atr * InpSL_ATR_Mult);\n      double tp = RoundToTick(ask + g_cache.atr * InpTP_ATR_Mult);\n\n      if(SendOrder(ORDER_TYPE_BUY, sl, tp))\n      {\n         g_tradesToday++;\n         g_lastEntryTime = TimeCurrent();\n         g_consecLosses = 0;\n      }\n      return;\n   }\n\n   check_sell: \n   if(downTrend && g_cache.rsi < InpRSI_SellLevel && IsVolumeConfirmed() &&\n      IsMultiTFConfirmed(false))\n   {\n      if(InpUseDivergence && !HasBearDivergence())\n         return;\n\n      double sl = RoundToTick(ask + g_cache.atr * InpSL_ATR_Mult);\n      double tp = RoundToTick(bid - g_cache.atr * InpTP_ATR_Mult);\n\n      if(SendOrder(ORDER_TYPE_SELL, sl, tp))\n      {\n         g_tradesToday++;\n         g_lastEntryTime = TimeCurrent();\n         g_consecLosses = 0;\n      }\n   }\n}//+------------------------------------------------------------------+